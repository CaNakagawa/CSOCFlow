{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://csocflow/schemas/hypothesis.schema.json",
  "title": "HypothesisDefinition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "category",
    "description",
    "mitre",
    "base_score",
    "minimum_score",
    "maximum_score",
    "conditions",
    "negative_conditions",
    "recommended_checks",
    "explanation_templates",
    "false_positive_context",
    "report_template"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^hypothesis\\."
    },
    "name": {
      "$ref": "#/definitions/localizedText"
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "$ref": "#/definitions/localizedText"
    },
    "mitre": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "base_score": {
      "type": "number"
    },
    "minimum_score": {
      "type": "number"
    },
    "maximum_score": {
      "type": "number"
    },
    "conditions": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/condition"
      }
    },
    "negative_conditions": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/condition"
      }
    },
    "recommended_checks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "explanation_templates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "missing",
        "counterpoints"
      ],
      "properties": {
        "summary": {
          "$ref": "#/definitions/localizedText"
        },
        "missing": {
          "$ref": "#/definitions/localizedText"
        },
        "counterpoints": {
          "$ref": "#/definitions/localizedText"
        }
      }
    },
    "false_positive_context": {
      "$ref": "#/definitions/localizedList"
    },
    "report_template": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "summary"
      ],
      "properties": {
        "title": {
          "$ref": "#/definitions/localizedText"
        },
        "summary": {
          "$ref": "#/definitions/localizedText"
        }
      }
    }
  },
  "definitions": {
    "localizedText": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        },
        "pt": {
          "type": "string",
          "minLength": 1
        },
        "de": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "localizedList": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en"
      ],
      "properties": {
        "en": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "pt": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "de": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "fact",
        "operator",
        "weight",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "fact": {
          "type": "string",
          "minLength": 1
        },
        "operator": {
          "enum": [
            "equals",
            "not_equals",
            "contains",
            "not_contains",
            "in",
            "not_in",
            "exists",
            "not_exists",
            "greater_than",
            "greater_than_or_equal",
            "less_than",
            "less_than_or_equal",
            "matches_any_selected_node",
            "has_relationship",
            "node_count_greater_than",
            "state_equals"
          ]
        },
        "value": {},
        "weight": {
          "type": "number"
        },
        "description": {
          "$ref": "#/definitions/localizedText"
        }
      }
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://csocflow/schemas/technique.schema.json",
  "title": "MitreTechnique",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "type",
    "tactics",
    "platforms",
    "brief",
    "expected_evidence",
    "related_hypotheses",
    "suggested_checks",
    "detection_analytics",
    "references"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "enum": [
        "mitre_technique",
        "mitre_subtechnique"
      ]
    },
    "tactics": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^TA[0-9]{4}$"
      },
      "minItems": 1
    },
    "platforms": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "brief": {
      "$ref": "#/definitions/localizedText"
    },
    "investigation_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "what_it_means",
        "why_it_matters",
        "suspicious_when",
        "legitimate_when",
        "common_mistakes"
      ],
      "properties": {
        "what_it_means": {
          "$ref": "#/definitions/localizedText"
        },
        "why_it_matters": {
          "$ref": "#/definitions/localizedText"
        },
        "suspicious_when": {
          "$ref": "#/definitions/localizedList"
        },
        "legitimate_when": {
          "$ref": "#/definitions/localizedList"
        },
        "common_mistakes": {
          "$ref": "#/definitions/localizedList"
        }
      }
    },
    "expected_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "related_hypotheses": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "suggested_checks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "detection_analytics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "detectionStrategyId",
          "description",
          "url"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^AN[0-9]+$"
          },
          "detectionStrategyId": {
            "type": "string",
            "pattern": "^DET[0-9]+$"
          },
          "description": {
            "$ref": "#/definitions/localizedText"
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "url"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    }
  },
  "definitions": {
    "localizedText": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        },
        "pt": {
          "type": "string",
          "minLength": 1
        },
        "de": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "localizedList": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en"
      ],
      "properties": {
        "en": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "pt": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "de": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://csocflow/schemas/check.schema.json",
  "title": "RecommendedCheckDefinition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "description",
    "reason",
    "expected_evidence_types",
    "priority",
    "answers"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^check\\."
    },
    "title": {
      "$ref": "#/definitions/localizedText"
    },
    "description": {
      "$ref": "#/definitions/localizedText"
    },
    "reason": {
      "$ref": "#/definitions/localizedText"
    },
    "expected_evidence_types": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "priority": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "answers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "value",
          "label",
          "effects"
        ],
        "properties": {
          "value": {
            "type": "string"
          },
          "label": {
            "$ref": "#/definitions/localizedText"
          },
          "effects": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "hypothesis_id",
                "score_delta"
              ],
              "properties": {
                "hypothesis_id": {
                  "type": "string"
                },
                "score_delta": {
                  "type": "number"
                }
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "localizedText": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        },
        "pt": {
          "type": "string",
          "minLength": 1
        },
        "de": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}

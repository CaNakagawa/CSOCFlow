{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://csocflow/schemas/evidence.schema.json",
  "title": "EvidenceTypeDefinition",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "category", "node_type", "brief", "fields", "educational_content"],
  "properties": {
    "id": { "type": "string", "pattern": "^evidence\\." },
    "name": { "$ref": "#/definitions/localizedText" },
    "category": { "type": "string", "minLength": 1 },
    "node_type": { "type": "string" },
    "brief": { "$ref": "#/definitions/localizedText" },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "type", "required"],
        "properties": {
          "id": { "type": "string" },
          "label": { "$ref": "#/definitions/localizedText" },
          "type": {
            "enum": ["string", "number", "boolean", "ip", "datetime", "string_array"]
          },
          "required": { "type": "boolean" }
        }
      }
    },
    "educational_content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["why_it_matters", "suspicious_when", "legitimate_when"],
      "properties": {
        "why_it_matters": { "$ref": "#/definitions/localizedText" },
        "suspicious_when": { "$ref": "#/definitions/localizedList" },
        "legitimate_when": { "$ref": "#/definitions/localizedList" }
      }
    }
  },
  "definitions": {
    "localizedText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "pt", "de"],
      "properties": {
        "en": { "type": "string", "minLength": 1 },
        "pt": { "type": "string", "minLength": 1 },
        "de": { "type": "string", "minLength": 1 }
      }
    },
    "localizedList": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "pt", "de"],
      "properties": {
        "en": { "type": "array", "items": { "type": "string" } },
        "pt": { "type": "array", "items": { "type": "string" } },
        "de": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
